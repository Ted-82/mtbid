{
  "name": "rexbid-feed-sync-production",
  "main": "./worker.feed-sync.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "REXBID_FEED_ENABLED": "enabled",
    "REXBID_FEED_DETAIL_ENABLED": "disabled",
    "REXBID_FEED_TARGET": "production",
    "REXBID_FEED_DATABASE_ID": "c8a30088-70af-43a6-9a7f-c4018279d37d",
    "REXBID_FEED_ID": "20",
    "REXBID_FEED_EXECUTION_MODE": "service",
    "REXBID_CATALOG_MEMBERSHIP_ENABLED": "enabled"
  },
  "d1_databases": [
    {
      "binding": "REXBID_DB",
      "database_name": "rexbid-production-preflight-db",
      "database_id": "c8a30088-70af-43a6-9a7f-c4018279d37d"
    }
  ],
  "r2_buckets": [
    {
      "binding": "REXBID_FEED_ARCHIVE",
      "bucket_name": "rexbid-feed-sync-production"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "REXBID_FEED_QUEUE",
        "queue": "rexbid-feed-sync-production"
      }
    ],
    "consumers": [
      {
        "queue": "rexbid-feed-sync-production",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 8,
        "max_concurrency": 1,
        "retry_delay": 60
      }
    ]
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "limits": {
    "cpu_ms": 300000
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "services": [
    {
      "service": "rexbid-feed-executor-production",
      "binding": "REXBID_FEED_EXECUTOR"
    }
  ]
}
