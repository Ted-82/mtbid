{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "mtbid",

  "main": "./worker.js",

  "compatibility_date": "2026-09-19",

  "vars": {
    "REXBID_CANONICAL_ORIGIN": "https://mtbid.tedn828.workers.dev",
    "REXBID_PROVIDER_BUDGET_MODE": "required"
  },

  "d1_databases": [
    {
      "binding": "REXBID_DB",
      "database_name": "rexbid-db",
      "database_id": "971879fe-04ed-4e8c-9dc6-5306980bb872",
      "migrations_dir": "migrations"
    }
  ],

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/car*",
      "/*.html",
      "/konto",
      "/ulubione",
      "/logowanie",
      "/rejestracja",
      "/reset-hasla",
      "/robots.txt",
      "/sitemap.xml",
      "/rexbid-door-estimator.js",
      "/rexbid-door-estimator-rates.js",
      "/rexbid-transport-rates.js",
      "/rexbid-transport-engine.js",
      "/rexbid-calculator-v3-rates.js"
    ]
  }
}
