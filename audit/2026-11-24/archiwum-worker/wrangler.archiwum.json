{
  "name": "rexbid-auction-archive-auto",
  "main": "./src/worker.archive-auto.js",
  "compatibility_date": "2026-11-17",
  "workers_dev": false,
  "preview_urls": false,
  "account_id": "7ff5a57444667c4eda2a6a7f0fc4120d",
  "vars": {
    "ARCHIVE_ENABLED": "yes"
  },
  "d1_databases": [
    {
      "binding": "REXBID_ARCHIVE_CATALOG",
      "database_name": "rexbid-active-catalog-meter-20261110",
