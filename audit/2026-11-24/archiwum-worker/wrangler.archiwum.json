    },
    {
      "binding": "REXBID_ARCHIVE_LEGACY",
      "database_name": "rexbid-production-preflight-db",
      "database_id": "c8a30088-70af-43a6-9a7f-c4018279d37d"
    }
  ],
  "r2_buckets": [
    {
      "binding": "REXBID_ARCHIVE_FEED",
      "bucket_name": "rexbid-feed-sync-production"
    },
    {
      "binding": "REXBID_AUCTION_ARCHIVE",
      "bucket_name": "rexbid-auction-history-private"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
