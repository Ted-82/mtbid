+async function terminalWindow(index,source,generation,after) {
+  // For a small compressed file the repeated root writes can exceed the input that caching would save.
+  if(generation.compressed_bytes<1024*1024){
+    delete index.terminalWindow;
+    const events=await publishedEvents(source,generation,after);
+    return {events,mayContinue:events.length===MAX_WORK+1};
+  }
+  const cached=index.terminalWindow;
+  if(cached?.version===1&&cached.generation===generation.generation_id&&cached.rawSha===generation.sha256&&
+      cached.start<=after&&Array.isArray(cached.events)&&cached.events.length>0&&cached.events.length<=WINDOW_EVENTS&&
+      cached.events.at(-1).sequence>after&&cached.checksum===await hash(JSON.stringify(cached.events))){
+    const remaining=cached.events.filter(event=>event.sequence>after);
+    const mayContinue=cached.events.length===WINDOW_EVENTS;
+    // Refresh a short, incomplete tail before this tick so the same 38 candidates are available.
+    if(!mayContinue||remaining.length>MAX_WORK) return {events:remaining,mayContinue};
+  }
+  const events=await publishedEvents(source,generation,after,WINDOW_EVENTS);
+  if(events.length&&JSON.stringify(events).length*32<=generation.compressed_bytes){
+    index.terminalWindow={version:1,generation:generation.generation_id,rawSha:generation.sha256,
+      start:after,events,checksum:await hash(JSON.stringify(events))};
+  }else delete index.terminalWindow;
+  return {events,mayContinue:events.length===WINDOW_EVENTS};
+}
