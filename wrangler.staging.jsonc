{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rexbid-auth-test",
  "main": "./worker.staging.js",
  "compatibility_date": "2026-09-19",
  "workers_dev": true,
  "vars": {
    "AUTH_ENABLED": "true",
    "AUTH_D1_SCHEMA_VERSION": "0003",
    "AUTH_CANONICAL_ORIGIN": "https://rexbid-auth-test.tedn828.workers.dev",
    "AUTH_ALLOWED_ORIGINS": "https://rexbid-auth-test.tedn828.workers.dev",
    "AUTH_RATE_LIMITING_MODE": "staging-bypass",
    "REXBID_AUTH_TEST_UI": "enabled",
    "REXBID_AUTH_TEST_HOST": "rexbid-auth-test.tedn828.workers.dev",
    "REXBID_AUTH_DIAGNOSTICS": "enabled",
    "REXBID_PHASE_G_MULTIPLATFORM": "enabled",
    "REXBID_D1_READ_DIAGNOSTICS": "enabled",
    "REXBID_D1_READ_TARGET": "rexbid-auth-test-db",
    "REXBID_D1_READ_MAX_AGE_MS": "86400000",
    "REXBID_D1_DETAIL_MAX_AGE_MS": "86400000",
    "REXBID_D1_HISTORY_MAX_AGE_MS": "21600000",
    "REXBID_D1_PRIMARY_READS": "true",
    "REXBID_TRANSPORT_CALCULATOR_ENABLED": "enabled",
    "REXBID_CALCULATOR_V3_ENABLED": "enabled",
    "REXBID_SYNC_HOT_INTERVAL_MS": "300000",
    "REXBID_SYNC_WARM_INTERVAL_MS": "21600000",
    "REXBID_SYNC_COLD_INTERVAL_MS": "604800000",
    "REXBID_SYNC_HOT_WINDOW_MS": "7200000",
    "REXBID_SYNC_SCOPE_STALE_AFTER_MS": "86400000"
  },
  "d1_databases": [
    {
      "binding": "REXBID_DB",
      "database_name": "rexbid-auth-test-db",
      "database_id": "acb3cb8e-69a2-459f-8a46-0f2f5b9004be",
      "migrations_dir": "migrations-staging"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/car*",
      "/*.html",
      "/konto",
      "/ulubione",
      "/logowanie",
      "/rejestracja",
      "/reset-hasla",
      "/robots.txt",
      "/sitemap.xml",
      "/rexbid-door-estimator.js",
      "/rexbid-door-estimator-rates.js",
      "/rexbid-transport-rates.js",
      "/rexbid-transport-engine.js",
      "/rexbid-calculator-v3-rates.js"
    ]
  }
}
